# Copy to .env and fill locally. .env is gitignored.
# Nothing here is a default identity.

# BAW profile name. Required before preview/broadcast.
# Do not rely on BINANCE_BAW_DIR alone.
OX_WALLET=

# BSC hot-path balance check (address, not a profile name).
MINT_WALLET=

# Pearl read-only challenge + optional submit.
PEARL_WALLET=
PEARL_AGENT_ID=
